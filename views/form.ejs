<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>New Message</title>
	</head>
	<body>
		<h1>New Message</h1>
		<% if (locals.errors) {%>
  			<ul>
    		<% errors.forEach(function(error) { %>
      			<li><%= error.msg %></li>
    			<% }); %>
  			</ul>
		<% } %>
		<form action="/new" method="POST">
			<h2>Please use the form below to write a new message:</h2>

			<label for="userName">User:</label>
			<input type="text" id="userName" name="userName" required placeholder="Write your username..." />

			<label for="userMessage">Message:</label>
			<textarea id="userMessage" name="userMessage" required placeholder="Write your message here..."></textarea>

			<button type="submit">Send</button>
		</form>
		<a href="/">Home</a>
	</body>
</html>
